rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /monsters/{id} {
      // 링크를 아는 사람은 누구나 볼 수 있음
      allow read: if true;
      // 아래 목록의 계정(구글 로그인 또는 이메일·비밀번호 로그인)만 추가·수정·삭제 가능
      allow write: if request.auth != null
                   && request.auth.token.email in ['본인 구글 이메일', '회사용 로그인 이메일'];
    }
  }
}
